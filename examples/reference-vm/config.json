{
    "boot-source": {
        "kernel_image_path": "examples/reference-vm/build/Image",
        "initrd_path": "examples/reference-vm/build/initramfs.cpio.gz",
        "boot_args": "console=ttyAMA0 earlycon=pl011,mmio32,0x0e0a0000 panic=1 reboot=k root=/dev/ram0 rdinit=/init squib_demo_ip=169.254.169.50 squib_demo_path=/latest/meta-data/instance-id"
    },
    "machine-config": {
        "vcpu_count": 1,
        "mem_size_mib": 256,
        "smt": false
    },
    "network-interfaces": [
        {
            "iface_id": "eth0",
            "host_dev_name": "tap-squib-demo"
        }
    ],
    "mmds-config": {
        "version": "V1",
        "network_interfaces": ["eth0"]
    }
}
