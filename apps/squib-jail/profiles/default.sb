(version 1)
;; Default sandbox profile bundled with squib-jail.
;;
;; Aligns with `specs/40-jailer.md` § 2.3:
;;   - deny network egress (the guest itself reaches the network through
;;     vmnet / gvproxy; the host-side jailer process does not need to talk
;;     out)
;;   - allow vmnet socket (mach-bootstrap lookup of the vmnet sharing
;;     service is implicit in `process-info-listpids` plus
;;     `mach-lookup com.apple.vmnet`)
;;   - allow `/srv/jailer/<id>` r/w (the chroot will already restrict
;;     filesystem visibility, but layered defence-in-depth is the point)
;;
;; This profile is permissive enough that a healthy squib boot completes;
;; tighten only after a full integration test pass.

;; Default deny — every operation must be explicitly allowed below.
(deny default)

;; Process and signal handling. The squib binary needs to fork worker
;; threads and signal them; without this signals get rejected.
(allow process-fork)
(allow process-exec)
(allow signal (target self))

;; Filesystem. Allow read of system shared resources; allow read+write
;; under the per-instance jail root. The jailer establishes the chroot
;; before sandbox_init so the rooted view is what we constrain.
(allow file-read* file-test-existence)
(allow file-write*
  (subpath "/srv/jailer")
  (subpath "/private/tmp")
  (subpath "/tmp"))

;; IPC. squib's API socket lives at `/run/firecracker.socket` (or the
;; operator's chosen path); the chroot's `/run` view is what the sandbox
;; sees, so subpath-bind there is enough.
(allow file-write-create
  (subpath "/run"))

;; Mach lookups. The vmnet sharing service is reached via mach-bootstrap.
;; `configd` removed: integration traces showed squib does not consult
;; `com.apple.SystemConfiguration.configd` directly — vmnet handles its
;; own configd lookups inside the framework, and squib never opens an
;; SCDynamicStore. Re-add only when a guarded test demonstrates a need.
(allow mach-lookup
  (global-name "com.apple.vmnet"))

;; Networking. UDS only — outbound TCP/UDP is denied by the default-deny
;; above; we explicitly re-allow only loopback unix-socket traffic that
;; squib itself uses for vsock multiplexing and the API server.
(allow network-bind (local unix-socket))
(allow network-outbound (local unix-socket))

;; Sysctl reads — squib reads /proc-equivalent sysctl knobs at startup
;; for HVF capability detection. Scope to the names that squib actually
;; queries (`hw.optional.arm.FEAT_*` and a handful of `kern.*` boot probes)
;; instead of the unrestricted form. Tightens the sandbox without breaking
;; any documented call site; new sysctl names need an explicit allowlist
;; entry rather than silently going through.
(allow sysctl-read
  (sysctl-name-prefix "hw.optional.arm.FEAT_")
  (sysctl-name "hw.activecpu")
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.physicalcpu")
  (sysctl-name "hw.logicalcpu")
  (sysctl-name "hw.memsize")
  (sysctl-name "hw.pagesize")
  (sysctl-name "kern.osproductversion")
  (sysctl-name "kern.osversion")
  (sysctl-name "kern.version")
  (sysctl-name "kern.boottime"))

;; Hypervisor entitlement is enforced separately at codesign time
;; (`com.apple.security.hypervisor`); the sandbox cannot tighten it
;; further but it also doesn't need to.
